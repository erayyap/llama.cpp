#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#if defined(DATA_A_Q8_0)
#include "types.glsl"
#endif

// Gathers the active KV rows of a top-k sparse attention (DeepSeek V4 CSA decode) into a
// compact contiguous scratch: rows [0, n_kv_raw) of the source (the dense prefix), followed
// by one n_top_k segment for each query token, then zero padding up to kv_c. Each query's
// compact mask exposes the raw prefix and only its own selected segment. This deliberately
// keeps duplicate selections across queries: it avoids a GPU union/hash pass and is small for
// speculative batches (<= 8), while still removing the full-context scan. Invalid top-k
// indices and padding get -inf masks and zeroed K. V is the K latent (V==K), so one gather
// serves both.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_Q8_0)
layout(binding = 0) readonly  buffer KBuf   { block_q8_0 data_k[];  };
#else
layout(binding = 0) readonly  buffer KBuf   { float16_t data_k[];   };
#endif
layout(binding = 1) readonly  buffer TopBuf { int       data_top[]; };
layout(binding = 2) readonly  buffer MBuf   { float16_t data_m[];   };
layout(binding = 3) writeonly buffer KcBuf  { float16_t data_kc[];  };
layout(binding = 4) writeonly buffer McBuf  { float16_t data_mc[];  };

layout(push_constant) uniform Parameters {
    uint n_kv;     // total source KV rows
    uint n_batch;  // query tokens sharing this compact K scratch
    uint n_kv_raw; // dense prefix length
    uint n_top_k;  // selected rows per query token
    uint kv_c;     // padded compact row count == dispatch row range
    uint nbk1;     // K source row stride, storage units (f16 elements or q8_0 blocks)
    uint nbk3;     // K source stream stride, storage units
    uint nbt1;     // top_k query stride, elements
    uint nbt3;     // top_k stream stride, elements
    uint nbm1;     // mask query stride, elements
    uint nbm3;     // mask source stream stride, elements
    uint nem3;     // mask ne[3], for stream broadcast
} p;

const uint HEAD_SIZE = 512;
const uint LANES = 64;

void main() {
    const uint row    = gl_WorkGroupID.x;
    const uint stream = gl_WorkGroupID.z;
    const uint tid    = gl_LocalInvocationIndex;

    // Map compact row -> source row. `owner == n_batch` denotes the shared raw
    // prefix; p.n_kv is the invalid source sentinel for padding/bad indices.
    uint src = p.n_kv;
    uint owner = p.n_batch;
    if (row < p.n_kv_raw) {
        src = row;
    } else if (row < p.n_kv_raw + p.n_batch * p.n_top_k) {
        const uint selected = row - p.n_kv_raw;
        owner = selected / p.n_top_k;
        const uint top_pos = selected - owner * p.n_top_k;
        const int idx = data_top[stream * p.nbt3 + owner * p.nbt1 + top_pos];
        if (idx >= 0 && uint(idx) < p.n_kv - p.n_kv_raw) {
            src = p.n_kv_raw + uint(idx);
        }
    }

    const uint dst_base = (stream * p.kv_c + row) * HEAD_SIZE;
    if (src < p.n_kv) {
        const uint src_base = stream * p.nbk3 + src * p.nbk1;
#if defined(DATA_A_Q8_0)
        // A 512-wide q8_0 row is 16 blocks. Four lanes cooperatively expand each
        // 32-value block, keeping source reads and f16 scratch writes contiguous.
        const uint block = tid / 4;
        const uint q_base = (tid % 4) * 8;
        const float d = float(data_k[src_base + block].d);
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            data_kc[dst_base + block * 32 + q_base + i] =
                float16_t(d * float(data_k[src_base + block].qs[q_base + i]));
        }
#else
        [[unroll]] for (uint i = 0; i < HEAD_SIZE / LANES; ++i) {
            data_kc[dst_base + tid + i * LANES] = data_k[src_base + tid + i * LANES];
        }
#endif
    } else {
        [[unroll]] for (uint i = 0; i < HEAD_SIZE / LANES; ++i) {
            data_kc[dst_base + tid + i * LANES] = float16_t(0.0);
        }
    }

    // The compact K is shared by every query, but selected segments are private.
    // Copy the original mask for the raw prefix and the owning query's segment;
    // all cross-query segments, invalid indices, and padding remain masked.
    if (tid < p.n_batch) {
        const uint query = tid;
        float16_t value = float16_t(uintBitsToFloat(0xff800000));
        if (src < p.n_kv && (owner == p.n_batch || owner == query)) {
            value = data_m[(stream % p.nem3) * p.nbm3 + query * p.nbm1 + src];
        }
        data_mc[(stream * p.n_batch + query) * p.kv_c + row] = value;
    }
}
